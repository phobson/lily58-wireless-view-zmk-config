#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        lt_ret: hold_tap_enter {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
        };

        lt_spc: hold_tap_spc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };

        double_spc_period: double_spc_period {
            compatible = "zmk,behavior-tap-dance";
            label = "DOUBLE_SPC_PERIOD";
            #binding-cells = <0>;
            bindings = <&kp SPACE>, <&kp PERIOD>, <&period_and_space>;

            tapping-term-ms = <250>;
        };

        ht_ctrl: ht_ctrl {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_CTRL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
        };

        mouse_ht: mouse_ht {
            compatible = "zmk,behavior-hold-tap";
            label = "MOUSE_HT";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
        };

        ht_wraps: ht_wraps {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_WRAPS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
        };

        hold_tap_math: hold_tap_math {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            bindings = <&mathspace>, <&kp>;

            flavor = "hold-preferred";
        };

        mod_paren: mod_paren {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mod_angle: mod_angle {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LESS_THAN>, <&kp GREATER_THAN>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mod_bracket: mod_bracket {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp RBKT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mod_brace: mod_brace {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE>, <&kp RIGHT_BRACE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        math_assign: math_assign {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&mathspace EQUAL>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        math_sum: math_sum {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(EQUAL)>, <&mathspace LS(EQUAL)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        math_difference: math_difference {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&mathspace MINUS>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        math_geom: math_geom {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N8)>, <&mathspace LS(N8)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        math_fraction: math_fraction {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&mathspace FSLH>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        math_bang: math_bang {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N1)>, <&mathspace LS(N1)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        math_at: math_at {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N2)>, <&mathspace LS(N2)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        math_pound: math_pound {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N3)>, <&mathspace LS(N3)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        math_money: math_money {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N4)>, <&mathspace LS(N4)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        math_pct: math_pct {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N5)>, <&mathspace LS(N5)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        math_caret: math_caret {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N6)>, <&mathspace LS(N6)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        math_and: math_and {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N7)>, <&mathspace LS(N7)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        math_or: math_or {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(BSLH)>, <&mathspace LS(BSLH)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        math_bslh: math_bslh {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSLH>, <&mathspace BSLH>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        math_Q: math_Q {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp QUESTION>, <&mathspace QUESTION>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        toggle_mac {
            bindings = <&to 5>;
            key-positions = <0 11>;
            layers = <0>;
        };

        toggle_windows {
            bindings = <&to 0>;
            key-positions = <0 11>;
            layers = <5>;
        };

        capsword {
            bindings = <&caps_word>;
            key-positions = <49 36>;
        };
    };

    macros {
        period_and_space: period_and_space {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOT &kp SPACE>;
            label = "PERIOD_AND_SPACE";
        };

        assign_py: assign_py {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp EQUAL &kp SPACE>;
            label = "ASSIGN_PY";
        };

        assign_type: assign_type {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp MINUS &kp GREATER_THAN &kp SPACE>;
            label = "ASSIGN_TYPE";
        };

        assign_R: assign_R {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp LESS_THAN &kp MINUS &kp SPACE>;
            label = "ASSIGN_R";
        };

        pipe_R: pipe_R {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp PIPE &kp GREATER_THAN &kp SPACE>;
            label = "PIPE_R";
        };

        assign_walrus: assign_walrus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp COLON &kp EQUAL &kp SPACE>;
            label = "ASSIGN_WALRUS";
        };

        less_equal: less_equal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp LESS_THAN &kp EQUAL &kp SPACE>;
            label = "LESS_EQUAL";
        };

        // surround operators in spaces

        mathspace: mathspace {
            label = "&MATHSPACE";
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            tap-ms = <30>;
            wait-ms = <15>;
            bindings = <&kp SPACE &macro_param_1to1 &kp MACRO_PLACEHOLDER &kp SPACE>;
        };

        greater_equal: greater_equal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp GREATER_THAN &kp EQUAL &kp SPACE>;
            label = "GREATER_EQUAL";
        };

        greater_than: greater_than {
            label = "&GREATER_THAN";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp LS(DOT) &kp SPACE>;
        };

        less_than: less_than {
            label = "&LESS_THAN";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp LS(COMMA) &kp SPACE>;
        };

        right_arrow: right_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp MINUS &kp GREATER_THAN &kp SPACE>;
            label = "RIGHT_ARROW";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&caps_word        &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                                         &kp N6     &kp N7    &kp N8     &kp N9   &kp N0    &kp CAPS
&lt 4 TAB         &kp Q   &kp W   &kp E     &kp R     &kp T                                          &kp Y      &kp U     &kp I      &kp O    &kp P     &kp MINUS
&lt_ret 3 ESCAPE  &kp A   &kp S   &kp D     &kp F     &kp G                                          &kp H      &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
&kp LEFT_SHIFT    &kp Z   &kp X   &kp C     &kp V     &kp B      &mkp LCLK          &mkp RCLK        &kp N      &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                                  &kp LALT  &kp LGUI  &kp LCTRL  &lt_spc 2 SPACE    &lt_ret 1 ENTER  &kp RCTRL  &kp RWIN  &kp BSPC
            >;
        };

        raise_layer {
            display-name = "NavWrapMath";
            bindings = <
&none       &none           &none         &none             &none              &none                           &none       &none       &none         &none       &none  &none
&none       &assign_walrus  &pipe_R       &kp SQT           &kp DOUBLE_QUOTES  &kp GRAVE                       &mod_angle  &mod_paren  &mod_bracket  &mod_brace  &none  &none
&none       &math_assign    &math_sum     &math_difference  &math_fraction     &math_geom                      &kp LEFT    &kp DOWN    &kp UP        &kp RIGHT   &none  &none
&caps_word  &assign_R       &assign_type  &kp UNDER         &kp COLON          &kp TILDE   &trans      &trans  &kp HOME    &kp PG_DN   &kp PG_UP     &kp END     &none  &trans
                                          &trans            &trans             &trans      &kp BSPC    &none   &trans      &trans      &trans
            >;
        };

        lower_layer {
            display-name = "FuncSym";
            bindings = <
&none   &none                   &none               &none            &none              &none                                 &none             &none                  &none              &none            &none                &kp PRINTSCREEN
&trans  &none                   &less_than          &greater_than    &less_equal        &greater_equal                        &kp GREATER_THAN  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &none                &none
&trans  &kp EXCLAMATION         &kp AT_SIGN         &kp HASH         &kp DLLR           &kp PERCENT                           &kp CARET         &kp AMPERSAND          &kp PIPE           &kp BSLH         &kp QUESTION         &none
&trans  &mathspace EXCLAMATION  &mathspace AT_SIGN  &mathspace HASH  &mathspace DOLLAR  &mathspace PERCENT  &trans    &trans  &mathspace CARET  &mathspace AMPERSAND   &mathspace PIPE    &mathspace BSLH  &mathspace QUESTION  &trans
                                                    &trans           &trans             &kp DEL             &trans    &trans  &trans
            >;
        };

        NumFunc {
            bindings = <
&trans  &trans  &trans  &trans   &trans     &trans                               &none         &none   &none       &none   &kp KP_PLUS      &none
&trans  &trans  &kp F1  &kp F2   &kp F3     &kp F4                               &kp EQUAL     &kp N7  &kp N8      &kp N9  &kp KP_MINUS     &none
&none   &trans  &kp F5  &kp F6   &kp F7     &kp F8                               &kp KP_ENTER  &kp N4  &kp N5      &kp N6  &kp KP_SLASH     &none
&trans  &trans  &kp F9  &kp F10  &kp F11    &kp F12  &trans       &trans         &kp KP_ENTER  &kp N1  &kp N2      &kp N3  &kp KP_MULTIPLY  &trans
                        &trans   &kp SPACE  &kp TAB  &kp SPACE    &kp BACKSPACE  &kp N0        &kp N0  &kp PERIOD
            >;
        };

        magic {
            display-name = "Blutoof";
            bindings = <
&none   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4                     &none   &none   &none   &none  &none  &none
&none   &kp C_MUTE    &kp C_VOL_DN  &kp C_VOLUME_UP   &kp C_BRI_UP  &none                            &none   &none   &none   &none  &none  &none
&none   &kp C_PREV    &kp C_NEXT    &kp C_PLAY_PAUSE  &kp C_BRI_DN  &none                            &none   &none   &none   &none  &none  &none
&trans  &none         &none         &none             &bt BT_CLR    &bt BT_CLR_ALL  &none    &trans  &trans  &none   &none   &none  &none  &none
                                    &trans            &trans        &trans          &none    &none   &none   &trans  &trans
            >;
        };

        os_toggle {
            display-name = "Mac";
            bindings = <
&trans  &trans  &trans  &trans     &trans    &trans                              &trans             &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans    &trans                              &trans             &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans    &trans                              &trans             &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans    &trans            &trans    &trans  &trans             &trans  &trans  &trans  &trans  &trans
                        &kp LCTRL  &kp LALT  &kp LEFT_COMMAND  &trans    &trans  &kp RIGHT_COMMAND  &trans  &trans
            >;
        };
    };
};
